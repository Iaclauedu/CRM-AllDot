# ==============================================================================
# AllDot CRM - Variáveis de Ambiente para Vercel & Supabase
# ==============================================================================
# Configure estas variáveis no painel da Vercel em:
# Project Settings -> Environment Variables

# Supabase (Obtenha em: Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# URL da Aplicação (na Vercel use a URL gerada pelo deploy, ex: https://alldot-crm.vercel.app)
NEXT_PUBLIC_APP_URL=https://alldot-crm.vercel.app
